// 随机组合交易：从特产标签抽三种不同商品，每种两个。一次交易同时获得这三种商品。
{
  // 是否启用：false 为停用；要使用这个示例，将这里改为 true。示例文件名不会阻止启用。
  "enabled": false,
  // 商店标签页的标题，直接写文字或自己的语言键；留空显示文件资源 ID。
  "title": "特产礼包",
  // 界面排列顺序，数字越小越靠前；同值按文件名排序。
  "order": 100,
  // 商店刷新：-1 跟随全局设置；-2 不刷新；0～23999 为游戏日刻数，22000 为 04:00、0 为 06:00。
  "refreshTime": -1,
  // 本商店的交易列表。可复制整个交易对象添加一行；可以把固定、随机交易放在同一商店。
  "offers": [
    {
      // 这条交易的编号，自己起一个英文名字。同一商店内不能重复；不是显示名，也不是物品 ID。改名或价格时别改编号。
      "id": "specialty_bundle",
      // 这条交易是否启用。此处 true 表示开启交易，但仍需把顶部商店的 enabled 改为 true 才会出现。
      "enabled": true,
      // 交易显示名，直接写文字即可；留空用商品名。也可以使用自己的语言键。
      "name": "随机特产礼包",
      // 交易类型：fixed 固定商品，random 从 source 中抽取商品。
      "type": "random",
      // 目标或商品来源：具体 ID、#标签、include/exclude 对象或公共池引用。下面就是可直接复制的写法。
      "source": "#teyvatdelight:teyvat_specialties",
      // 抽取次数：1 抽一个目标或商品，2 抽两个；不是物品数量。
      "drawCount": 3,
      // 每次抽中的目标需要多少个，或每种抽中的商品/奖励给多少个。2 次抽取、每次 3 个就是两份各 3 个。
      "count": 2,
      // 多次抽取是否允许抽到相同候选：false 不允许，true 允许。重复物品数量会相加；与 repeatable 无关。
      "repeat": false,
      // 是否为随机装备附魔：true 开启，false 关闭。合法等级、适用性和互斥规则仍生效；概率由全局 equipment 控制。
      "enchantEquipment": false,
      // 一次交易同时收取的全部材料，必须一起付齐。item 为物品 ID，count 为实际个数；[] 表示免费。
      "cost": [
        {"item":"teyvatdelight:mora","count":5}
      ],
      // 每位玩家每个刷新周期可交易几次：-1 不限量，0 停售，正整数为限购次数。
      "dailyLimit": 1
    }
  ]
}
