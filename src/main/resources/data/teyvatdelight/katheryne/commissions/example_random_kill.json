// 随机讨伐委托：引用生物公共池，每次随机选一种生物，击杀五只。
{
  // 是否启用：false 为停用；要使用这个示例，将这里改为 true。示例文件名不会阻止启用。
  "enabled": false,
  // 界面排列顺序，数字越小越靠前；同值按文件名排序。
  "order": 100,
  // 界面标题，直接写你想显示的文字。也可写自己资源包中的语言键；委托留空会显示目标摘要。
  "title": "清理怪物",
  // 委托介绍，直接写文字即可；留空时显示所需提交或击杀等目标摘要。
  "description": "击败委托选中的怪物五只。",
  // 界面图标的物品 ID。留空会自动选用目标物品或生物；不填贴图文件名。
  "icon": "",
  // 这道委托的抽取权重，必须大于 0。2 相比 1 约有两倍被抽中的机会。
  "weight": 1,
  // 能否反复完成：true 可以；false 表示每位玩家只能成功完成一次。未完成或过期仍可重接。
  "repeatable": true,
  // 是否为重要委托：true 时未完成的委托永久有效、置顶、标题红色、无阴影且不使用偏移加粗，不占普通委托上限或每日普通委托发放数量；领奖后按普通规则清理。
  "important": false,
  // 是否紧急：满足前置条件后立即派发；普通任务只在刷新时抽取。
  "urgent": false,
  // 接取前置条件：[] 表示不限制；多条默认全部满足。参看 example_condition_*.json。
  "conditions": [],
  // 成功提交并领取奖励后解锁的进度 ID；[] 表示不解锁。示例：["minecraft:story/root"]。
  "completionAdvancements": [],
  // 委托奖励：空字符串继承全局奖励；也可写奖励文件 ID 或 items/random 对象。{} 表示不给奖励。
  "reward": "",
  // 以下所有目标都要完成才能领取奖励。物品目标需要一次交齐所有材料。
  "targets": [
    {
      // 目标类型：item 提交物品，kill 击杀生物，stat 原版统计，event 联动事件。
      "type": "kill",
      // 目标或商品来源：具体 ID、#标签、include/exclude 对象或公共池引用。下面就是可直接复制的写法。
      "source": {
        // 公共池文件 ID，不加 .json。例如 teyvatdelight:example_items 对应 pools/example_items.json。
        "pool": "teyvatdelight:example_entities"
      },
      // 抽取次数：1 抽一个目标或商品，2 抽两个；不是物品数量。
      "drawCount": 1,
      // 每个抽中的生物要击杀多少只。
      "count": 5,
      // 多次抽取是否允许抽到相同候选：false 不允许，true 允许。重复物品数量会相加；与 repeatable 无关。
      "repeat": false
    }
  ]
}
