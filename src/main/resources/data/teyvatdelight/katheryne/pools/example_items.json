// 物品公共池示例：不被默认内容引用，不会产生商品或委托。引用写法："source": {"pool": "teyvatdelight:example_items"}。公共池不需要 enabled。
{
  // 公共池类型：item 为物品，entity 为生物。
  "type": "item",
  // 候选直接写 ID 或 #标签时权重为 1；也可写 ["ID或#标签", 权重]。权重必须大于 0，2 相比 1 约有两倍被抽中的机会。
  "include": [
    "minecraft:apple",
    // 此候选的相对权重为 2；影响它在这个池内被抽中的机会。
    ["minecraft:bread", 2],
    "#minecraft:planks"
  ],
  // 排除的 ID 或 #标签；[] 表示不排除。标签必须属于对应的物品或生物注册表。
  "exclude": ["minecraft:oak_planks"]
}
